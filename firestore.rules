rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasActiveMembership() {
      return signedIn()
        && exists(/databases/$(database)/documents/organization_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/organization_members/$(request.auth.uid)).data.status == "active";
    }

    function memberOrganizationId() {
      return get(/databases/$(database)/documents/organization_members/$(request.auth.uid)).data.organizationId;
    }

    function belongsToOrganization(organizationId) {
      return hasActiveMembership() && memberOrganizationId() == organizationId;
    }

    function orgResourceRequestTypes() {
      return ["resource_create", "resource_edit", "resource_delete"];
    }

    function requestTopLevelFields() {
      return [
        "resourceId",
        "resourceName",
        "organizationId",
        "submittedByUid",
        "submittedByEmail",
        "requestType",
        "status",
        "proposedData",
        "submitterNotes",
        "reviewNotes",
        "createdAt",
        "updatedAt",
        "cancelledAt"
      ];
    }

    function requestRequiredFields() {
      return [
        "resourceId",
        "resourceName",
        "organizationId",
        "submittedByUid",
        "submittedByEmail",
        "requestType",
        "status",
        "proposedData",
        "submitterNotes",
        "reviewNotes",
        "createdAt",
        "updatedAt"
      ];
    }

    function orgProposedDataFields() {
      return [
        "resourceTitle",
        "Description",
        "DescriptionDelta",
        "Categories",
        "Subcategories",
        "Keywords",
        "Websites",
        "PhoneNumbers",
        "Email",
        "Address",
        "City",
        "Zip",
        "Latitude",
        "Longitude",
        "IncludeInMap",
        "Hours",
        "Eligibility",
        "Cost",
        "Languages",
        "Notes",
        "NotesDelta",
        "Website",
        "Phone"
      ];
    }

    function proposedDataLegacyFieldsAreBlank(proposedData) {
      return (!proposedData.keys().hasAny(["Website"]) || proposedData.Website == "")
        && (!proposedData.keys().hasAny(["Phone"]) || proposedData.Phone == "");
    }

    function hasSafeOrgProposedData(data) {
      return data.proposedData is map
        && data.proposedData.keys().hasOnly(orgProposedDataFields())
        && proposedDataLegacyFieldsAreBlank(data.proposedData);
    }

    function linkedResourceBelongsToMember(data) {
      return data.resourceId is string
        && data.resourceId != ""
        && exists(/databases/$(database)/documents/resources/$(data.resourceId))
        && get(/databases/$(database)/documents/resources/$(data.resourceId)).data.organizationId == memberOrganizationId();
    }

    function hasValidOrgRequestTarget(data) {
      return (data.requestType == "resource_create" && data.resourceId == "")
        || ((data.requestType == "resource_edit" || data.requestType == "resource_delete")
          && linkedResourceBelongsToMember(data));
    }

    function hasValidOrgRequestShape(data) {
      return data.keys().hasOnly(requestTopLevelFields())
        && data.keys().hasAll(requestRequiredFields())
        && data.organizationId == memberOrganizationId()
        && data.submittedByUid == request.auth.uid
        && data.submittedByEmail == request.auth.token.email
        && data.requestType in orgResourceRequestTypes()
        && data.status == "pending"
        && data.reviewNotes == ""
        && !data.keys().hasAny(["cancelledAt"])
        && hasValidOrgRequestTarget(data)
        && hasSafeOrgProposedData(data);
    }

    function isPublishedResource() {
      return resource.data.status == "published";
    }

    match /resources/{resourceId} {
      allow read: if isAdmin()
        || belongsToOrganization(resource.data.organizationId)
        || isPublishedResource();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /organizations/{organizationId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (belongsToOrganization(organizationId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["primaryEmail", "phone", "website", "updatedAt", "updatedBy", "updatedByEmail"]));
    }

    match /organization_members/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /editor_invites/{inviteId} {
      allow read: if isAdmin()
        || (hasActiveMembership()
          && resource.data.organizationId == memberOrganizationId()
          && request.auth.token.email == resource.data.email);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (hasActiveMembership()
          && resource.data.organizationId == memberOrganizationId()
          && request.auth.token.email == resource.data.email
          && resource.data.status == "sent"
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.email == resource.data.email
          && request.resource.data.status == "accepted"
          && request.resource.data.firebaseUid == request.auth.uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(["status", "firebaseUid", "acceptedAt", "updatedAt"]));
    }

    match /resource_change_requests/{requestId} {
      allow read: if isAdmin() || (hasActiveMembership() && resource.data.organizationId == memberOrganizationId());
      allow create: if hasActiveMembership()
        && hasValidOrgRequestShape(request.resource.data);
      allow update: if isAdmin()
        || (hasActiveMembership()
          && resource.data.organizationId == memberOrganizationId()
          && resource.data.status == "pending"
          && resource.data.requestType in orgResourceRequestTypes()
          && request.resource.data.keys().hasOnly(requestTopLevelFields())
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.submittedByUid == resource.data.submittedByUid
          && request.resource.data.submittedByEmail == resource.data.submittedByEmail
          && request.resource.data.requestType == resource.data.requestType
          && (
            (request.resource.data.status == "pending"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["resourceName", "proposedData", "submitterNotes", "updatedAt"])
              && hasValidOrgRequestTarget(request.resource.data)
              && hasSafeOrgProposedData(request.resource.data))
            || (request.resource.data.status == "cancelled"
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "cancelledAt", "updatedAt"]))
          ));
      allow delete: if isAdmin();
    }

    match /review_confirmations/{token} {
      allow read: if isAdmin()
        || (resource.data.type == "quarterly_review"
          && resource.data.status in ["sent", "confirmed", "applied"]
          && resource.data.expiresAt > request.time);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.type == "quarterly_review"
          && resource.data.status == "sent"
          && resource.data.expiresAt > request.time
          && request.resource.data.status == "confirmed"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "confirmedAt", "updatedAt"]));
    }

    match /mail_queue/{mailId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /auth_user_actions/{actionId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (hasActiveMembership()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorType == "org_editor"
          && request.resource.data.organizationId == memberOrganizationId());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
